# =============================================================================
# PacketRoot .gitignore
# =============================================================================

# Output directories
output/
results/
analysis/
reports/
exports/

# Generated artifacts
*.json
*.csv
*.html
*.xml

# PCAP files (except test samples)
*.pcap
*.pcapng
*.cap
*.pcap.gz

!tests/test_data/
!tests/test_data/*.pcap
!tests/test_data/*.pcapng

# Logs
*.log
*.txt.log

# Temporary/runtime files
*.tmp
*.temp
*.cache
*.pid
*.lock
*.swp
*.swo
*~

# Bash/debug artifacts
bash-debug.log
set-x.log

# Core dumps
core
*.core
core.*

# Backup files
*.bak
*.backup
*.old
*.orig
*.rej

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.python-version
.venv/
venv/
env/

# Ruby/Gem artifacts
.bundle/
vendor/
*.gem

# Node.js (future web UI/support tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor/IDE files
.vscode/
.idea/
*.sublime-*
*.code-workspace

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# Archives / extracted files
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Binary files
*.exe
*.dll
*.bin
*.o
*.a
*.out

# Test artifacts
test_output/
test_captures/
coverage/
*.coverage

# Documentation build artifacts
docs/_build/
site/
*.pdf

# Local environment/configuration
.env
.env.*
config.local
config.dev
config.test

# Installer/runtime logs
packetroot-install.log

# ShellCheck / BATS artifacts
*.bats~
